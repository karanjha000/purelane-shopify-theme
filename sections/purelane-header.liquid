{% comment %}
  Purelane Header Section (Matching Base CSS classes & prototype styling)
{% endcomment %}

{{ 'purelane-header.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_ticker -%}
  <div class="ticker" aria-label="Announcement bar">
    <div class="track">
      {%- if section.blocks.size > 0 -%}
        {%- for i in (1..2) -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'ticker_item' -%}
              <span {{ block.shopify_attributes }}>
                {{ block.settings.text_regular }}
                {%- if block.settings.text_bold != blank -%}
                  <b>{{ block.settings.text_bold }}</b>
                {%- endif -%}
              </span>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      {%- else -%}
        <span>Free shipping <b>on every bundle across India</b></span>
        <span>100% plant-based <b>and non-toxic</b></span>
        <span>Loved by <b>30,000+ happy homes</b></span>
        <span>Buy 3 <b>at flat ₹499</b></span>
        <span>Free shipping <b>on every bundle across India</b></span>
        <span>100% plant-based <b>and non-toxic</b></span>
        <span>Loved by <b>30,000+ happy homes</b></span>
        <span>Buy 3 <b>at flat ₹499</b></span>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

<header id="hdr">
  <div class="navpill glass">
    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }} Home">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 100 }}"
          alt="{{ shop.name }}"
          class="brand-logo-img"
          width="40"
          height="40"
          loading="eager"
        >
      {%- else -%}
        <span class="mark">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3 20.5 8v8L12 21 3.5 16V8L12 3Z"/>
            <path d="M12 12 20.5 8M12 12v9M12 12 3.5 8"/>
          </svg>
        </span>
      {%- endif -%}
      <span class="txt">
        <span class="n1">{{ section.settings.brand_name | default: shop.name }}</span>
        <span class="n2">{{ section.settings.brand_tagline | default: 'Clean, simply' }}</span>
      </span>
    </a>

    <nav class="nav" aria-label="Main navigation">
      {%- assign main_menu = section.settings.menu | default: 'main-menu' -%}
      {%- if linklists[main_menu].links.size > 0 -%}
        {%- for link in linklists[main_menu].links -%}
          <a href="{{ link.url }}" class="{% if link.active %}active{% endif %}">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="#top">Home</a>
        <a href="#ingredients">Ingredients</a>
        <a href="#how">How it works</a>
        <a href="#shop">Shop</a>
        <a href="#bundles">Bundles</a>
      {%- endif -%}
    </nav>

    <div class="navtools">
      {%- if section.settings.show_search -%}
        <a href="{{ routes.search_url }}" class="ico hide-s" aria-label="Search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
            <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
          </svg>
        </a>
      {%- endif -%}

      {%- if shop.customer_accounts_enabled and section.settings.show_account -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="ico hide-s" aria-label="Account">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
            <circle cx="12" cy="8" r="3.6"/><path d="M5 20c0-3.6 3.1-5.6 7-5.6s7 2 7 5.6"/>
          </svg>
        </a>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" class="ico" aria-label="Cart, {{ cart.item_count }} items">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 6h2l2.2 10.4a1.6 1.6 0 0 0 1.6 1.3h7.6a1.6 1.6 0 0 0 1.6-1.3L20.5 9H6.4"/>
          <circle cx="10" cy="20.5" r="1.1"/><circle cx="17.5" cy="20.5" r="1.1"/>
        </svg>
        <span class="dot">{{ cart.item_count }}</span>
      </a>

      <button type="button" class="ico burger" aria-label="Toggle Navigation Menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M4 8h16M4 16h16"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var header = document.getElementById('hdr');
    if (!header) return;
    window.addEventListener('scroll', function() {
      if (window.scrollY > 40) {
        header.classList.add('up');
      } else {
        header.classList.remove('up');
      }
    });
  });
</script>

{% schema %}
{
  "name": "Purelane Header",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_ticker",
      "label": "Show Announcement Ticker Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "Purelane"
    },
    {
      "type": "text",
      "id": "brand_tagline",
      "label": "Brand Tagline",
      "default": "Clean, simply"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Brand Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show Account Icon",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "ticker_item",
      "name": "Announcement Item",
      "settings": [
        {
          "type": "text",
          "id": "text_regular",
          "label": "Regular Text",
          "default": "Free shipping"
        },
        {
          "type": "text",
          "id": "text_bold",
          "label": "Bold Highlighted Text",
          "default": "on every bundle across India"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Header",
      "blocks": [
        {
          "type": "ticker_item",
          "settings": {
            "text_regular": "Free shipping",
            "text_bold": "on every bundle across India"
          }
        },
        {
          "type": "ticker_item",
          "settings": {
            "text_regular": "100% plant-based",
            "text_bold": "and non-toxic"
          }
        },
        {
          "type": "ticker_item",
          "settings": {
            "text_regular": "Loved by",
            "text_bold": "30,000+ happy homes"
          }
        },
        {
          "type": "ticker_item",
          "settings": {
            "text_regular": "Buy 3",
            "text_bold": "at flat ₹499"
          }
        }
      ]
    }
  ]
}
{% endschema %}
