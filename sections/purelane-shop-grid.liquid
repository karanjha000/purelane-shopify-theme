{% comment %}
  Bestsellers / shop grid. Products are added as blocks (not a hardcoded
  collection loop) so a merchant can pick exact products, reorder them,
  and set a per-product badge — all from the theme editor, no code.
{% endcomment %}

{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-shop-grid.css' | asset_url | stylesheet_tag }}

<section class="sec purelane-shop" id="{{ section.settings.anchor_id | default: 'shop' }}" data-section-id="{{ section.id }}">
  <div class="wrap">
    <div class="panel-head rv">
      {% if section.settings.kicker != blank %}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      {% endif %}
      <div class="rule" aria-hidden="true">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>

    <div class="shelf">
      {% for block in section.blocks %}
        {% if block.type == 'product' %}
          {% assign product = block.settings.product %}
          {% if product != blank %}
            {% render 'purelane-product-card',
              product: product,
              card_index: forloop.index,
              badge_text: block.settings.badge_override %}
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>

    {% if section.blocks.size == 0 %}
      <div class="shop-grid-empty" {% if request.design_mode %}style="display:block;padding:24px;text-align:center;opacity:.6"{% endif %}>
        {% if request.design_mode %}Add product blocks to populate this shelf.{% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Shop grid",
  "tag": "section",
  "class": "section-purelane-shop",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor ID", "default": "shop", "info": "Used for #shop style links from other sections." },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by 30,000 homes" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "badge_override", "label": "Badge text (optional)", "info": "e.g. Best seller, Top rated, New. Leave blank to use the product's Shelf badge metafield, or no badge." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop grid",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
