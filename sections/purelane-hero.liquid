{% comment %}
  Hero. The "stage" (1/2/3 product bundle) pricing switcher is decorative
  illustration + editable pricing text, matching the prototype's own use of
  drawn bottle shapes rather than product photography here. All copy,
  badges, and stage pricing are merchant-editable blocks.
{% endcomment %}

{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign badge_blocks = section.blocks | where: 'type', 'badge'
  assign stage_blocks = section.blocks | where: 'type', 'stage'
-%}

<section class="hero" data-section-id="{{ section.id }}">
  <div class="hero-grid">

    {% if badge_blocks.size > 0 %}
      <div class="badges glass-2" aria-label="Product promises">
        {% for block in badge_blocks %}
          <div class="badge" {{ block.shopify_attributes }}>
            <span class="bi">{% render 'purelane-icon', icon: block.settings.icon %}</span>
            <span>{{ block.settings.label }}</span>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    <div class="hero-copy">
      <h1 class="d1 rv in">
        {{ section.settings.headline_line_1 }}<br>
        {{ section.settings.headline_line_2 }}<br>
        <span class="lime">{{ section.settings.headline_highlight }}</span>
      </h1>
      <div class="rule rv rv-d1" aria-hidden="true">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
      <p class="lede rv rv-d2">{{ section.settings.subheading }}</p>
      <div class="hero-cta rv rv-d3">
        {% if section.settings.primary_cta_text != blank %}
          <a class="btn btn-primary" href="{{ section.settings.primary_cta_link | default: '#shop' }}">
            {{ section.settings.primary_cta_text }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          </a>
        {% endif %}
        {% if section.settings.secondary_cta_text != blank %}
          <a class="btn btn-ghost" href="{{ section.settings.secondary_cta_link | default: '#how' }}">{{ section.settings.secondary_cta_text }}</a>
        {% endif %}
      </div>

      {% if badge_blocks.size > 0 %}
        <div class="badgestrip rv rv-d4">
          {% for block in badge_blocks %}
            <div class="glass-2">
              {% render 'purelane-icon', icon: block.settings.icon %}
              {{ block.settings.short_label | default: block.settings.label }}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% if stage_blocks.size > 0 %}
      <div class="hero-prod" id="heroProd-{{ section.id }}">
        <div class="hstage" id="hstage-{{ section.id }}">
          {% for block in stage_blocks %}
            {%- liquid
              assign n = forloop.index
              assign bottle_classes = 'p-kbtl,p-tbtl,p-mbtl' | split: ','
            -%}
            <div class="hslide hs{{ n }}{% if forloop.first %} on{% endif %}" data-n="{{ n }}" {{ block.shopify_attributes }}>
              {% for i in (1..block.settings.bottle_count) %}
                {% assign bclass = bottle_classes[forloop.index0] | default: 'p-kbtl' %}
                <span class="hp {{ bclass }} {{ 'a,b,c' | split: ',' | slice: forloop.index0 }} d{{ forloop.index }}" role="img" aria-label="{{ block.settings.label }} illustration {{ forloop.index }}"></span>
              {% endfor %}
              <div class="glass-2 ptag">
                <span class="lbl">{{ block.settings.label }}</span>
                <span class="val">
                  <strong>{{ block.settings.price }}</strong>
                  {% if block.settings.compare_price != blank %}<s>{{ block.settings.compare_price }}</s>{% endif %}
                </span>
                {% if block.settings.savings_text != blank %}<span class="cut">{{ block.settings.savings_text }}</span>{% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
        <div class="hdots" id="hdots-{{ section.id }}" role="tablist" aria-label="Choose bundle size">
          {% for block in stage_blocks %}
            <button type="button" class="{% if forloop.first %}on{% endif %}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Show {{ block.settings.bottle_count }} product{% if block.settings.bottle_count != 1 %}s{% endif %}" data-n="{{ forloop.index }}"></button>
          {% endfor %}
        </div>
      </div>
    {% endif %}

  </div>
</section>

<script src="{{ 'purelane-hero.js' | asset_url }}" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.PurelaneHero) window.PurelaneHero.init('{{ section.id }}');
  });
  document.addEventListener('shopify:section:load', function (e) {
    if (e.detail.sectionId === '{{ section.id }}' && window.PurelaneHero) window.PurelaneHero.init('{{ section.id }}');
  });
</script>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section-purelane-hero",
  "settings": [
    { "type": "text", "id": "headline_line_1", "label": "Headline line 1", "default": "Clean" },
    { "type": "text", "id": "headline_line_2", "label": "Headline line 2", "default": "That" },
    { "type": "text", "id": "headline_highlight", "label": "Headline highlight word", "default": "Lasts" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it." },
    { "type": "text", "id": "primary_cta_text", "label": "Primary button text", "default": "Shop now" },
    { "type": "url", "id": "primary_cta_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_cta_text", "label": "Secondary button text", "default": "How it works" },
    { "type": "url", "id": "secondary_cta_link", "label": "Secondary button link" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Promise badge",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "leaf", "label": "Leaf" },
          { "value": "shield", "label": "Shield" },
          { "value": "circle-check", "label": "Circle check" }
        ], "default": "leaf" },
        { "type": "text", "id": "label", "label": "Label (use a line break as needed)", "default": "Plant powered" },
        { "type": "text", "id": "short_label", "label": "Short label for the bottom strip (optional)" }
      ]
    },
    {
      "type": "stage",
      "name": "Bundle pricing stage",
      "settings": [
        { "type": "range", "id": "bottle_count", "label": "Number of bottles shown", "min": 1, "max": 3, "step": 1, "default": 1 },
        { "type": "text", "id": "label", "label": "Label", "default": "Single bottle" },
        { "type": "text", "id": "price", "label": "Price", "default": "₹200" },
        { "type": "text", "id": "compare_price", "label": "Compare-at price (optional)", "default": "₹299" },
        { "type": "text", "id": "savings_text", "label": "Savings/discount text", "default": "33% off" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "badge", "settings": { "icon": "leaf", "label": "Plant<br>powered", "short_label": "Plant powered" } },
        { "type": "badge", "settings": { "icon": "shield", "label": "Safe for<br>kids & pets", "short_label": "Kids & pet safe" } },
        { "type": "badge", "settings": { "icon": "circle-check", "label": "Zero harsh<br>chemicals", "short_label": "Zero harsh chem" } },
        { "type": "stage", "settings": { "bottle_count": 1, "label": "Single bottle", "price": "₹200", "compare_price": "₹299", "savings_text": "33% off" } },
        { "type": "stage", "settings": { "bottle_count": 2, "label": "Any 2 products", "price": "₹349", "compare_price": "₹598", "savings_text": "Save ₹249" } },
        { "type": "stage", "settings": { "bottle_count": 3, "label": "Any 3 products", "price": "₹499", "compare_price": "₹897", "savings_text": "Save ₹398" } }
      ]
    }
  ]
}
{% endschema %}
