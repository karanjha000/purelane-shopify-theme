{% comment %}
  Bundle tier cards (2 / 3 / 5 product boxes). Like Combos, tier pricing
  is a distinct merchant-set offer, not a sum of variant prices — so
  price/compare/per-item text are editable fields, while the small
  product icon row references real products for accurate imagery.
{% endcomment %}

{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-bundles.css' | asset_url | stylesheet_tag }}

<section class="sec purelane-bundles" id="{{ section.settings.anchor_id | default: 'bundles' }}" data-section-id="{{ section.id }}">
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        {% if section.settings.kicker != blank %}<span class="kicker">{{ section.settings.kicker }}</span>{% endif %}
        {% if section.settings.heading != blank %}<h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>{% endif %}
        {% if section.settings.subheading != blank %}<p class="lede" style="margin:0 auto">{{ section.settings.subheading }}</p>{% endif %}
      </div>
    </div>

    <div class="tiers">
      {% for block in section.blocks %}
        {% if block.type == 'tier' %}
          <article class="glass tier{% if block.settings.featured %} best{% endif %} rv" {{ block.shopify_attributes }}>
            {% if block.settings.tag != blank %}<span class="tag">{{ block.settings.tag }}</span>{% endif %}

            <div class="tierpix{% if block.settings.product_count >= 5 %} five{% endif %}" aria-hidden="true">
              {% for i in (1..5) %}
                {% assign product_key = 'item' | append: i | append: '_product' %}
                {% assign product = block.settings[product_key] %}
                {% if product != blank %}
                  {% if product.featured_image %}
                    <img class="pimg" src="{{ product.featured_image | image_url: width: 124 }}" alt="" loading="lazy" width="124" height="124">
                  {% else %}
                    <span class="tile" role="img">{% render 'purelane-icon', icon: 'leaf' %}</span>
                  {% endif %}
                {% endif %}
              {% endfor %}
            </div>

            <div class="qty">{{ block.settings.product_count }}<small>Products</small></div>
            <div class="price">
              {{ block.settings.price }}
              {% if block.settings.compare_price != blank %}<s>{{ block.settings.compare_price }}</s>{% endif %}
            </div>
            {% if block.settings.per_item_text != blank %}<p class="body-s" style="font-size:12px">{{ block.settings.per_item_text }}</p>{% endif %}

            {%- liquid
              assign bullets = block.settings.bullets | newline_to_br | split: '<br />'
            -%}
            {% if block.settings.bullets != blank %}
              <ul>
                {% for bullet in bullets %}
                  {% assign trimmed = bullet | strip %}
                  {% if trimmed != blank %}
                    <li>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                      {{ trimmed }}
                    </li>
                  {% endif %}
                {% endfor %}
              </ul>
            {% endif %}

            <a class="btn {% if block.settings.featured %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.cta_link | default: '#shop' }}">
              {{ block.settings.cta_text | default: 'Build this box' }}
              {% if block.settings.featured %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
              {% endif %}
            </a>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundle tiers",
  "tag": "section",
  "class": "section-purelane-bundles",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor ID", "default": "bundles" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Build your bundle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One box. Every room." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way." }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle tier",
      "settings": [
        { "type": "text", "id": "tag", "label": "Tag", "default": "Starter" },
        { "type": "range", "id": "product_count", "label": "Product count", "min": 2, "max": 5, "step": 1, "default": 2 },
        { "type": "text", "id": "price", "label": "Price", "default": "₹349" },
        { "type": "text", "id": "compare_price", "label": "Compare-at price" },
        { "type": "text", "id": "per_item_text", "label": "Per-item price note", "default": "Flat ₹174 per product" },
        { "type": "textarea", "id": "bullets", "label": "Feature bullets (one per line)", "default": "Pick any two products\nFree shipping across India" },
        { "type": "checkbox", "id": "featured", "label": "Featured / most popular styling", "default": false },
        { "type": "text", "id": "cta_text", "label": "Button text", "default": "Build this box" },
        { "type": "url", "id": "cta_link", "label": "Button link" },
        { "type": "header", "content": "Product icons shown (up to 5)" },
        { "type": "product", "id": "item1_product", "label": "Product 1" },
        { "type": "product", "id": "item2_product", "label": "Product 2" },
        { "type": "product", "id": "item3_product", "label": "Product 3 (optional)" },
        { "type": "product", "id": "item4_product", "label": "Product 4 (optional)" },
        { "type": "product", "id": "item5_product", "label": "Product 5 (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle tiers",
      "blocks": [
        { "type": "tier", "settings": { "tag": "Starter", "product_count": 2, "price": "₹349", "compare_price": "₹598", "per_item_text": "Flat ₹174 per product", "bullets": "Pick any two products\nFree shipping across India" } },
        { "type": "tier", "settings": { "tag": "Most popular", "product_count": 3, "price": "₹499", "compare_price": "₹897", "per_item_text": "Flat ₹166 per product", "bullets": "Pick any three products\nCovers kitchen and laundry\nFree shipping across India", "featured": true } },
        { "type": "tier", "settings": { "tag": "Whole home", "product_count": 5, "price": "₹799", "compare_price": "₹1,495", "per_item_text": "Flat ₹160 per product", "bullets": "Pick any five products\nEvery room in one order\nFree shipping across India" } }
      ]
    }
  ]
}
{% endschema %}
