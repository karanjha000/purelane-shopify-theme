{% comment %}
  Horizontal-scroll rail of pre-built product combos. Each combo is a
  block referencing 2-5 real products (for real images/titles) plus
  editable combo-level pricing, since Shopify has no native "bundle
  product" concept — the combo price is a distinct offer, not a sum
  of variant prices.
{% endcomment %}

{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-combos.css' | asset_url | stylesheet_tag }}

<section class="sec purelane-combos" id="{{ section.settings.anchor_id | default: 'combos' }}" data-section-id="{{ section.id }}">
  <div class="wrap">
    <div class="panel-head rv">
      {% if section.settings.kicker != blank %}<span class="kicker">{{ section.settings.kicker }}</span>{% endif %}
      {% if section.settings.heading != blank %}<h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>{% endif %}
      <div class="rule" aria-hidden="true">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
      {% if section.settings.subheading != blank %}<p class="lede" style="margin:14px auto 0">{{ section.settings.subheading }}</p>{% endif %}
    </div>

    <div class="comborail rv" role="list">
      {% for block in section.blocks %}
        {% if block.type == 'combo' %}
          {%- liquid
            assign items = block.settings.items | split: '||'
          -%}
          <article class="glass combo{% if block.settings.featured %} hero-combo{% endif %}" role="listitem" {{ block.shopify_attributes }}>
            <div class="tray">
              {% if block.settings.savings_text != blank %}<span class="save">{{ block.settings.savings_text }}</span>{% endif %}
              {% if block.settings.flag_text != blank %}<span class="flag">{{ block.settings.flag_text }}</span>{% endif %}
              <div class="stack">
                {% for i in (1..5) %}
                  {% assign product_key = 'item' | append: i | append: '_product' %}
                  {% assign caption_key = 'item' | append: i | append: '_caption' %}
                  {% assign product = block.settings[product_key] %}
                  {% assign caption = block.settings[caption_key] %}
                  {% if product != blank %}
                    {% unless forloop.first %}<span class="plus" aria-hidden="true">+</span>{% endunless %}
                    <span class="it">
                      {% if product.featured_image %}
                        <img class="pimg" src="{{ product.featured_image | image_url: width: 132 }}" alt="{{ product.title | escape }}" loading="lazy" width="66" height="66">
                      {% else %}
                        <span class="tile" role="img" aria-label="{{ product.title | escape }}">{% render 'purelane-icon', icon: 'leaf' %}</span>
                      {% endif %}
                      <span>{{ caption | default: product.title }}</span>
                    </span>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
            <div class="body">
              <h3>{{ block.settings.title }}</h3>
              <div class="cnt">{{ block.settings.product_count }} products</div>
              {% if block.settings.description != blank %}<p class="inc">{{ block.settings.description }}</p>{% endif %}
              <div class="prow">
                <strong>{{ block.settings.price }}</strong>
                {% if block.settings.compare_price != blank %}<s>{{ block.settings.compare_price }}</s>{% endif %}
                {% if block.settings.savings_text != blank %}<em>{{ block.settings.savings_text }}</em>{% endif %}
              </div>
              <div class="fine">{{ block.settings.fine_print | default: 'Inclusive of all taxes · COD available' }}</div>
              <a class="btn {% if block.settings.featured %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.cta_link | default: '#bundles' }}">
                {{ block.settings.cta_text | default: 'Shop bundle' }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
              </a>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>

    <div class="swipecue" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
      Swipe for more combos
    </div>
    {% if section.settings.footnote != blank %}<p class="railnote">{{ section.settings.footnote }}</p>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Best-selling combos",
  "tag": "section",
  "class": "section-purelane-combos",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor ID", "default": "combos" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pre-built to save you money" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own." },
    { "type": "textarea", "id": "footnote", "label": "Footnote", "default": "Tapping \"Shop bundle\" opens the bundle picker with these products already added. You can still swap anything before you pay." }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo card",
      "settings": [
        { "type": "text", "id": "title", "label": "Combo title", "default": "Kitchen essentials" },
        { "type": "text", "id": "product_count", "label": "Product count label", "default": "3" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "price", "label": "Price", "default": "₹499" },
        { "type": "text", "id": "compare_price", "label": "Compare-at price" },
        { "type": "text", "id": "savings_text", "label": "Savings badge text", "default": "Save ₹398" },
        { "type": "text", "id": "flag_text", "label": "Flag text (optional, e.g. Most popular)" },
        { "type": "checkbox", "id": "featured", "label": "Featured / hero combo styling", "default": false },
        { "type": "text", "id": "fine_print", "label": "Fine print", "default": "Inclusive of all taxes · COD available" },
        { "type": "text", "id": "cta_text", "label": "Button text", "default": "Shop bundle" },
        { "type": "url", "id": "cta_link", "label": "Button link" },
        { "type": "header", "content": "Products in this combo (up to 5)" },
        { "type": "product", "id": "item1_product", "label": "Product 1" },
        { "type": "text", "id": "item1_caption", "label": "Product 1 caption" },
        { "type": "product", "id": "item2_product", "label": "Product 2" },
        { "type": "text", "id": "item2_caption", "label": "Product 2 caption" },
        { "type": "product", "id": "item3_product", "label": "Product 3" },
        { "type": "text", "id": "item3_caption", "label": "Product 3 caption" },
        { "type": "product", "id": "item4_product", "label": "Product 4 (optional)" },
        { "type": "text", "id": "item4_caption", "label": "Product 4 caption" },
        { "type": "product", "id": "item5_product", "label": "Product 5 (optional)" },
        { "type": "text", "id": "item5_caption", "label": "Product 5 caption" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best-selling combos",
      "blocks": [
        { "type": "combo" },
        { "type": "combo" },
        { "type": "combo" }
      ]
    }
  ]
}
{% endschema %}
